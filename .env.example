# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (3000 in local dev, injected automatically by Render).
PORT="3000"

# VITE_SITE_ROLE: Set to "portal" for Dark Web main site, or "admin" for standalone Admin Control Panel on Render.
VITE_SITE_ROLE="portal"
